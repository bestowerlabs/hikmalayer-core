# Hikmalayer Bootnode Configuration — NEVER commit the real .env file
# Copy to .env and fill in real values

# Genesis keys — generate with: ./target/release/hikma-wallet keygen
BOOTNODE_VALIDATOR_KEY=replace-with-private-key
BOOTNODE_TREASURY_KEY=replace-with-same-private-key
GENESIS_TREASURY_ADDRESS=replace-with-hkm-address
GENESIS_VALIDATOR_PUBLIC_KEY=replace-with-public-key
GENESIS_VALIDATOR_VRF_PUBLIC_KEY=replace-with-vrf-public-key

# Shared authentication tokens
# Generate with: openssl rand -hex 32
P2P_TOKEN=replace-with-strong-random-token
ADMIN_TOKEN=replace-with-strong-random-token

# P2P allow-list — comma-separated node IDs
# Get node IDs from: docker compose logs <node> | grep "P2P node identity"
P2P_ALLOWLIST=hkm<bootnode-id>,hkm<val1-id>,hkm<val2-id>,hkm<val3-id>,hkm<val4-id>
P2P_REQUIRE_IDENTITY=true

# Grafana password
# Generate with: openssl rand -hex 16
GF_SECURITY_ADMIN_PASSWORD=replace-with-strong-password
