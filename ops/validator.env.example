# Hikmalayer Validator Configuration — NEVER commit the real .env file
# Copy to .env and fill in real values

# Your validator key — generate with: ./target/release/hikma-wallet keygen
VALIDATOR_PRIVATE_KEY=replace-with-your-private-key
NODE_ID=replace-with-your-hkm-address

# Bootnode connection
BOOTNODES=https://hikmalayer.com

# Shared tokens — get from supervisor
P2P_TOKEN=replace-with-token-from-supervisor
ADMIN_TOKEN=replace-with-token-from-supervisor

# P2P identity enforcement
P2P_REQUIRE_IDENTITY=true
