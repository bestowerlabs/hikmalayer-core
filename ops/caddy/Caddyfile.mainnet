# Once hikmalayer.com is registered and DNS points to this server:
# hikmalayer.com {
#     reverse_proxy bootnode:3000
# }
# www.hikmalayer.com {
#     redir https://hikmalayer.com{uri} permanent
# }

# Current config - self-signed TLS (update once domain is registered)
:443 {
    tls internal
    reverse_proxy bootnode:3000
}

:80 {
    redir https://{host}{uri} permanent
}
